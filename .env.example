# Copy this file, rename the copy to .env, and fill in your values.
# Find both in Supabase: Project Settings > API Keys (URL is under Data API).
# The publishable key is safe to use in the browser. Never put the secret key here.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
